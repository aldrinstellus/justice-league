# Justice League Missions - Anthropic API Configuration
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit the .env file to git (it's gitignored)

# Anthropic API Key (get from https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_API_KEY_HERE

# API Configuration
ANTHROPIC_API_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_VERSION=2023-06-01

# Expense Tracking Configuration
JUSTICE_LEAGUE_ROOT=/Users/admin/Documents/claudecode/justice-league-missions
UPDATE_FREQUENCY=after-each-activity
ENABLE_AUTO_SYNC=true

# Alert Configuration
ALERT_EMAIL=aldrinstellus@gmail.com
ENABLE_EMAIL_ALERTS=false
BUDGET_ALERT_THRESHOLDS=50,75,85,90,95,100

# Optional: Slack/Discord Webhooks (for future use)
# SLACK_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=
